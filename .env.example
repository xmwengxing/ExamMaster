# ============================================
# EduMaster 刷题系统 - 环境变量配置
# ============================================

# -------------------- 应用配置 --------------------

# Node 环境 (development | production)
NODE_ENV=production

# 后端服务端口
PORT=3001

# -------------------- 数据库配置 --------------------

# PostgreSQL 数据库主机
# 本地开发: localhost
# Docker 部署: postgres (容器名称)
DB_HOST=localhost

# PostgreSQL 数据库端口
DB_PORT=5432

# 数据库名称
DB_NAME=edumaster

# 数据库用户名
DB_USER=edumaster_user

# 数据库密码 (生产环境必须修改为强密码)
# 建议: 至少 16 位，包含大小写字母、数字、特殊字符
DB_PASSWORD=your_strong_database_password_here_change_in_production

# -------------------- 安全配置 --------------------

# JWT 密钥 (用于用户认证，生产环境必须修改)
# 建议: 使用随机生成的长字符串
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here-change-this-in-production

# -------------------- 第三方服务 --------------------

# DeepSeek API Key (可选，用于 AI 功能)
# 也可以在系统设置中配置
DEEPSEEK_API_KEY=

# -------------------- Docker 配置 --------------------

# 以下配置仅在 Docker 部署时使用

# PostgreSQL 数据卷路径 (可选)
# POSTGRES_DATA_PATH=./postgres/data

# Nginx HTTP 端口
# HTTP_PORT=80

# Nginx HTTPS 端口
# HTTPS_PORT=443

# -------------------- 注意事项 --------------------
# 1. 复制此文件为 .env 并修改相应的值
# 2. 不要将 .env 文件提交到版本控制系统
# 3. 生产环境必须修改所有密码和密钥
# 4. Docker 部署时，DB_HOST 应设置为 'postgres'
