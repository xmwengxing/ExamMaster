# ============================================
# EduMaster 刷题系统 - 环境变量配置
# ============================================

# -------------------- 应用配置 --------------------

# Node 环境 (development | production)
NODE_ENV=production

# 后端服务端口
PORT=3001

# -------------------- 数据库配置 --------------------

# PostgreSQL 数据库主机
# ⚠️ 重要：根据部署方式选择正确的配置
# 本地开发: localhost
# Docker 部署: postgres (容器名称，必须使用此值)
# ⚠️ 生产环境 Docker 部署时必须设置为 postgres
DB_HOST=postgres

# PostgreSQL 数据库端口
# ⚠️ 重要：根据部署方式选择正确的端口
# Docker 部署: 5432（容器内部端口，必须使用此值）
# 本地开发: 5434（如果需要避免端口冲突）
DB_PORT=5432

# 数据库名称
DB_NAME=edumaster

# 数据库用户名
DB_USER=edumaster_user

# 数据库密码 (生产环境必须修改为强密码)
# ⚠️ 安全要求：
#   - 长度：至少 16 位
#   - 复杂度：必须包含大小写字母、数字、特殊字符
#   - 生成方法：node scripts/generate-secure-passwords.js
# ⚠️ 不要使用默认密码！
# ⚠️ 不要在多个系统中使用相同的密码！
DB_PASSWORD=QT$yQ_5&<1^pMXdODE88>SB-N,|:#!zo

# -------------------- 安全配置 --------------------

# JWT 密钥 (用于用户认证，生产环境必须修改)
# ⚠️ 安全要求：
#   - 使用随机生成的长字符串（至少 64 字符）
#   - 生成方法：node scripts/generate-secure-passwords.js
#   - 或使用：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ 不要使用默认密钥！
# ⚠️ 泄露此密钥将导致严重的安全问题！
JWT_SECRET=f5491f8ae6b116a42d6f0a1cc6e56764e936c449eeaaed56514ba455e967869e

# CORS 允许的来源域名（多个域名用逗号分隔）
# ⚠️ 安全要求：
#   - 不要使用通配符 * （允许所有来源）
#   - 仅添加需要访问 API 的域名
#   - 生产环境必须配置实际的域名
# 示例：
#   生产环境: https://exammaster.zzzjl.com
#   开发环境: http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS=https://exammaster.zzzjl.com,http://localhost:5173

# -------------------- 第三方服务 --------------------

# DeepSeek API Key (可选，用于 AI 功能)
# 也可以在系统设置中配置
DEEPSEEK_API_KEY=

# -------------------- Docker 配置 --------------------

# 以下配置仅在 Docker 部署时使用

# PostgreSQL 数据卷路径 (可选)
# POSTGRES_DATA_PATH=./postgres/data

# Nginx HTTP 端口
# HTTP_PORT=80

# Nginx HTTPS 端口
# HTTPS_PORT=443

# -------------------- 注意事项 --------------------
# 1. 复制此文件为 .env 并修改相应的值
#    cp .env.example .env
#
# 2. 生成强密码和密钥
#    node scripts/generate-secure-passwords.js
#
# 3. 设置文件权限（仅所有者可读写）
#    chmod 600 .env
#
# 4. 不要将 .env 文件提交到版本控制系统
#    确保 .env 在 .gitignore 中
#
# 5. 生产环境必须修改所有密码和密钥
#    不要使用默认值或示例值
#
# 6. Docker 部署时，DB_HOST 应设置为 'postgres'
#
# 7. 定期更换密码（建议每 90 天）
#
# 8. 使用密码管理器安全存储密码
#
# 9. 不要通过不安全的渠道（如邮件、即时消息）传输密码
#
# 10. 参考安全加固文档：postgres/SECURITY_HARDENING.md
