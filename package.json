    "dompurify": "^3.3.1",
    "dotenv": "^16.1.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "marked": "^5.1.1",
    "pg": "^8.17.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.6.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
