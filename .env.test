# 测试环境配置文件
# 此文件仅用于参考，实际测试环境变量在 tests/setup.js 中设置

NODE_ENV=test
PORT=3002

# JWT 配置
JWT_SECRET=test-secret-key

# 数据库配置（测试数据库）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=edumaster_test
DB_USER=postgres
DB_PASSWORD=postgres

# 日志配置
LOG_LEVEL=error

# CORS 配置
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 注意：
# 1. 测试数据库应该与开发/生产数据库分离
# 2. 可以使用 Docker 快速启动测试数据库
# 3. 测试完成后应该清理测试数据
